{
  "name": "pvz-shift",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:vk": "tsc -b && PLATFORM=vk vite build --outDir dist-vk",
    "dev:vk": "PLATFORM=vk vite",
    "deploy:vk": "npm run build:vk && vk-miniapps-deploy",
    "build:mobile": "tsc -b && PLATFORM=web SINGLE=1 vite build --outDir dist-mobile",
    "build:android": "tsc -b && PLATFORM=web vite build --outDir dist-android && cap sync android"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/rubik-mono-one": "^5.3.0",
    "@vkontakte/vk-bridge": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vkontakte/vk-miniapps-deploy": "^1.0.3",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
